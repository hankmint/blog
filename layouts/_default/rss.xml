{{- /* RSS. Adopted from the Micro.blog export theme (MIT, Copyright 2019
       Micro.blog). Serves /feed.xml, which the site footer links and which
       existing readers subscribe to. Full post content, not summaries, and the
       original guid preserved so subscribers do not see the back catalogue
       arrive again as new. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <atom:link href="{{ .Site.BaseURL }}feed.xml" rel="self" type="application/rss+xml" />
    <description>{{ .Site.Params.description | plainify }}</description>
    {{ with .Site.LanguageCode }}<language>{{ . }}</language>{{ end }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{ range first 25 (where .Site.RegularPages "Type" "post").ByDate.Reverse }}
    <item>
      {{ with .Title }}<title>{{ . }}</title>{{ end }}
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- if .Params.guid }}
      <guid isPermaLink="false">{{ .Params.guid }}</guid>
      {{- else }}
      <guid>{{ .Permalink }}</guid>
      {{- end }}
      <description>{{ .Content | html }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
